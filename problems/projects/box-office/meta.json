        "PaginationTests.test_page_size_is_capped"
      ]
    },
    {
      "id": "quantity",
      "pattern": "input-validation",
      "summary": "parse_quantity() is a bare int(): text or a missing quantity is a 500, and 0, negative, or more than 10 tickets are accepted.",
      "files": ["boxoffice/services.py"],
      "tests": [
        "QuantityValidationTests.test_text_quantity",
        "QuantityValidationTests.test_missing_quantity",

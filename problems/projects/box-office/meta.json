      "id": "pagination",
      "pattern": "pagination",
      "summary": "paginate() calls int() on page and page_size with no fallback: a missing or non-numeric value raises, and zero or a negative number slices backwards.",
      "files": ["boxoffice/pagination.py"],
      "tests": [
        "PaginationTests.test_missing_page_defaults_to_first",

{
  "name": "chudcode",
  "version": "0.1.0",
  "private": true,
  "description": "A mock technical interviewer you can code against: original interview-style problems in a local web UI with an editor, hidden tests, a timer, hints, and spaced review of the patterns you miss.",
  "type": "module",
  "license": "MIT",
  "author": "Maddox Johnson",
  "homepage": "https://github.com/maddoxrjohnson/ChudCode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maddoxrjohnson/ChudCode.git"
  },
  "bugs": {
    "url": "https://github.com/maddoxrjohnson/ChudCode/issues"
  },
  "keywords": [
    "interview",
    "coding-interview",
    "leetcode",
    "practice",
    "mcp",
    "claude-code"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "bundle:editor": "node scripts/bundle-editor.mjs",
    "serve": "node scripts/serve.ts",
    "solve": "node scripts/run.ts"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.14",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "marked": "18.1.0"
  }
}
